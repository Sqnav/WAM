@@ -0,0 +1,90 @@
+"""Compute UAV state/action normalization stats without decoding RGB images."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import numpy as np
+import pyarrow.parquet as pq
+import tyro
+
+from openpi.shared import normalize
+
+
+def _fixed_size_list_to_numpy(column, width: int) -> np.ndarray:
+    values = column.combine_chunks().values.to_numpy(zero_copy_only=False)
+    return np.asarray(values, dtype=np.float32).reshape(-1, width)
+
+
+def main(
+    dataset_dir: str,
+    output_dir: str,
+    *,
+    action_horizon: int = 8,
+    batch_size: int = 48,
+) -> None:
+    dataset_path = Path(dataset_dir).expanduser().resolve()
+    parquet_files = sorted((dataset_path / "data").rglob("*.parquet"))
+    if not parquet_files:
+        raise FileNotFoundError(f"No parquet episodes found under {dataset_path / 'data'}")
+
+    stats = {
+        "state": normalize.RunningStats(),
+        "actions": normalize.RunningStats(),
+    }
+    state_buffer: list[np.ndarray] = []
+    action_buffer: list[np.ndarray] = []
+    buffered = 0
+    processed_frames = 0
+
+    def flush_full_batches() -> None:
+        nonlocal state_buffer, action_buffer, buffered
+        if buffered < batch_size:
+            return
+        states = np.concatenate(state_buffer, axis=0)
+        actions = np.concatenate(action_buffer, axis=0)
+        full_count = states.shape[0] // batch_size * batch_size
+        for start in range(0, full_count, batch_size):
+            stop = start + batch_size
+            stats["state"].update(states[start:stop])
+            stats["actions"].update(actions[start:stop])
+        state_buffer = [states[full_count:]] if full_count < states.shape[0] else []
+        action_buffer = [actions[full_count:]] if full_count < actions.shape[0] else []
+        buffered = states.shape[0] - full_count
+
+    for episode_index, path in enumerate(parquet_files):
+        table = pq.read_table(path, columns=["state", "action"])
+        states = _fixed_size_list_to_numpy(table.column("state"), 4)
+        actions = _fixed_size_list_to_numpy(table.column("action"), 4)
+        if states.shape[0] == 0:
+            continue
+        horizon_indices = np.minimum(
+            np.arange(states.shape[0])[:, None] + np.arange(action_horizon)[None, :],
+            states.shape[0] - 1,
+        )
+        action_chunks = actions[horizon_indices]
+        state_buffer.append(states)
+        action_buffer.append(action_chunks)
+        buffered += states.shape[0]
+        processed_frames += states.shape[0]
+        flush_full_batches()
+        if (episode_index + 1) % 1000 == 0:
+            print(
+                f"[uav-norm] episodes={episode_index + 1}/{len(parquet_files)} "
+                f"frames={processed_frames}",
+                flush=True,
+            )
+
+    # Match OpenPI's TorchDataLoader behavior: it uses len(dataset) // batch_size
+    # complete batches and drops the final incomplete batch.
+    norm_stats = {key: value.get_statistics() for key, value in stats.items()}
+    normalize.save(Path(output_dir).expanduser().resolve(), norm_stats)
+    print(
+        f"[uav-norm] complete episodes={len(parquet_files)} "
+        f"frames={processed_frames} dropped_tail={buffered} output={output_dir}",
+        flush=True,
+    )
+
+
+if __name__ == "__main__":
+    tyro.cli(main)
diff --git a/examples/uav/convert_uav_data_to_lerobot.py b/examples/uav/convert_uav_data_to_lerobot.py
new file mode 100644
index 0000000..b68ab64
--- /dev/null
+++ b/examples/uav/convert_uav_data_to_lerobot.py
@@ -0,0 +1,225 @@
+"""Convert the Worldmodel UAV pursuit demonstrations to LeRobot format."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import shutil
+
+from lerobot.common.datasets.lerobot_dataset import HF_LEROBOT_HOME
+from lerobot.common.datasets.lerobot_dataset import LeRobotDataset
+from lerobot.common.datasets.lerobot_dataset import LeRobotDatasetMetadata
+import numpy as np
+import tyro
+
+
+REPO_ID = "worldmodel/uav_pursuit_city1_27_train"
+
+
+def _action(frame: dict) -> np.ndarray:
+    delta = frame["body_frame_delta"]
+    return np.asarray(
+        [delta["x"], delta["y"], delta["z"], frame["body_frame_yaw_delta"]],
+        dtype=np.float32,
+    )
+
+
+def _open_for_append(repo_id: str, output_path: Path) -> LeRobotDataset:
+    """Open a locally recorded dataset without rescanning embedded image bytes."""
+    dataset = LeRobotDataset.__new__(LeRobotDataset)
+    dataset.meta = LeRobotDatasetMetadata(repo_id=repo_id, root=output_path)
+    dataset.repo_id = repo_id
+    dataset.root = output_path
+    dataset.revision = None
+    dataset.tolerance_s = 1e-4
+    dataset.image_writer = None
+    dataset.episodes = None
+    dataset.hf_dataset = dataset.create_hf_dataset()
+    dataset.image_transforms = None
+    dataset.delta_timestamps = None
+    dataset.delta_indices = None
+    dataset.episode_data_index = None
+    dataset.video_backend = None
+    dataset.episode_buffer = dataset.create_episode_buffer()
+    return dataset
+
+
+def main(
+    dataset_root: str,
+    *,
+    scene_start: int = 1,
+    scene_end: int = 27,
+    trajectory_start: int = 1,
+    trajectory_end: int = 450,
+    repo_id: str = REPO_ID,
+    overwrite: bool = False,
+    resume: bool = False,
+) -> None:
+    dataset_root_path = Path(dataset_root).expanduser().resolve()
+    output_path = HF_LEROBOT_HOME / repo_id
+    completion_path = output_path / ".worldmodel_complete.json"
+    progress_path = output_path / ".worldmodel_progress.json"
+    if overwrite and resume:
+        raise ValueError("--overwrite and --resume are mutually exclusive")
+
+    skipped_trajectories: list[str] = []
+    source_cursor = 0
+    if output_path.exists():
+        if completion_path.is_file() and not overwrite:
+            print(f"[uav-convert] reuse existing dataset: {output_path}")
+            return
+        if resume:
+            if progress_path.is_file():
+                progress = json.loads(progress_path.read_text(encoding="utf-8"))
+                skipped_trajectories = list(progress.get("skipped_trajectories", []))
+                source_cursor = int(progress.get("source_cursor", 0))
+            dataset = _open_for_append(repo_id, output_path)
+            # Metadata is committed after every parquet file. It is therefore
+            # authoritative if the process stopped after saving an episode but
+            # before updating the lightweight source progress marker.
+            source_cursor = max(
+                source_cursor,
+                dataset.meta.total_episodes + len(skipped_trajectories),
+            )
+            dataset.episode_buffer = dataset.create_episode_buffer()
+            print(
+                f"[uav-convert] resume output={output_path} "
+                f"episodes={dataset.meta.total_episodes} source_cursor={source_cursor}",
+                flush=True,
+            )
+        elif not overwrite:
+            raise RuntimeError(
+                f"Incomplete UAV LeRobot dataset exists at {output_path}; "
+                "rerun with --resume or --overwrite."
+            )
+        else:
+            shutil.rmtree(output_path)
+
+    if not output_path.exists():
+        dataset = LeRobotDataset.create(
+            repo_id=repo_id,
+            robot_type="uav_body_velocity",
+            fps=1,
+            features={
+                "image": {
+                    "dtype": "image",
+                    "shape": (640, 640, 3),
+                    "names": ["height", "width", "channel"],
+                },
+                "state": {
+                    "dtype": "float32",
+                    "shape": (4,),
+                    "names": ["previous_vx", "previous_vy", "previous_vz", "previous_yaw_rate"],
+                },
+                "action": {
+                    "dtype": "float32",
+                    "shape": (4,),
+                    "names": ["vx", "vy", "vz", "yaw_rate"],
+                },
+            },
+            image_writer_threads=16,
+            image_writer_processes=8,
+        )
+
+    episode_count = dataset.meta.total_episodes
+    frame_count = dataset.meta.total_frames
+    source_ordinal = 0
+    for city_index in range(scene_start, scene_end + 1):
+        scene_id = f"City_{city_index}"
+        for trajectory_index in range(trajectory_start, trajectory_end + 1):
+            trajectory_dir = dataset_root_path / scene_id / f"trajectory_{trajectory_index:04d}"
+            if source_ordinal < source_cursor:
+                source_ordinal += 1
+                continue
+            trajectory_path = trajectory_dir / "uav_trajectory.json"
+            instruction_path = trajectory_dir / "instruction.json"
+            if not trajectory_path.is_file():
+                raise FileNotFoundError(trajectory_path)
+            trajectory = json.loads(trajectory_path.read_text(encoding="utf-8"))
+            instruction = (
+                json.loads(instruction_path.read_text(encoding="utf-8"))
+                if instruction_path.is_file()
+                else trajectory
+            )
+            prompt = str(
+                instruction.get("instruction")
+                or instruction.get("instructions")
+                or "Track and approach the target UAV while avoiding collisions."
+            )
+            frames = trajectory["trajectory"]
+            previous_action = np.zeros(4, dtype=np.float32)
+            episode_buffer = dataset.create_episode_buffer()
+            for frame_index, frame in enumerate(frames):
+                # The terminal frame has no transition to supervise. Excluding it
+                # avoids teaching an artificial stop action at every episode end.
+                if frame.get("body_frame_delta") is None or frame.get("body_frame_yaw_delta") is None:
+                    continue
+                image_path = trajectory_dir / "rgb" / f"frame_{frame_index:05d}.png"
+                if not image_path.is_file():
+                    raise FileNotFoundError(image_path)
+                action = _action(frame)
+                local_frame_index = int(episode_buffer["size"])
+                episode_buffer["frame_index"].append(local_frame_index)
+                episode_buffer["timestamp"].append(local_frame_index / dataset.fps)
+                episode_buffer["image"].append(str(image_path))
+                episode_buffer["state"].append(previous_action.copy())
+                episode_buffer["action"].append(action)
+                episode_buffer["task"].append(prompt)
+                episode_buffer["size"] += 1
+                previous_action = action
+                frame_count += 1
+            if int(episode_buffer["size"]) == 0:
+                trajectory_key = f"{scene_id}/{trajectory_dir.name}"
+                skipped_trajectories.append(trajectory_key)
+                source_ordinal += 1
+                source_cursor = source_ordinal
+                tmp_path = progress_path.with_suffix(".json.tmp")
+                tmp_path.write_text(
+                    json.dumps(
+                        {
+                            "source_cursor": source_cursor,
+                            "episodes": episode_count,
+                            "frames": frame_count,
+                            "skipped_trajectories": skipped_trajectories,
+                        },
+                        indent=2,
+                    ),
+                    encoding="utf-8",
+                )
+                tmp_path.replace(progress_path)
+                print(f"[uav-convert] skip empty trajectory: {trajectory_key}", flush=True)
+                continue
+            # The Hugging Face image feature embeds these source paths directly
+            # into parquet. Avoiding an intermediate decoded/re-encoded PNG copy
+            # materially reduces conversion time and temporary disk usage.
+            dataset.episode_buffer = episode_buffer
+            dataset.save_episode()
+            episode_count += 1
+            source_ordinal += 1
+            source_cursor = source_ordinal
+            if episode_count % 100 == 0:
+                print(
+                    f"[uav-convert] episodes={episode_count} frames={frame_count} "
+                    f"last={scene_id}/{trajectory_dir.name}",
+                    flush=True,
+                )
+
+    completion_path.write_text(
+        json.dumps(
+            {
+                "scene_range": [scene_start, scene_end],
+                "trajectory_range": [trajectory_start, trajectory_end],
+                "episodes": episode_count,
+                "frames": frame_count,
+                "source_trajectories": source_cursor,
+                "skipped_trajectories": skipped_trajectories,
+            },
+            indent=2,
+        ),
+        encoding="utf-8",
+    )
+    print(f"[uav-convert] complete output={output_path} episodes={episode_count} frames={frame_count}")
+
+
+if __name__ == "__main__":
+    tyro.cli(main)
